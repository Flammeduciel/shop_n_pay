# Auth.js
# Générer la valeur avec : openssl rand -base64 32
AUTH_SECRET=remplacer-par-une-chaine-aleatoire-de-32-octets
AUTH_URL=http://localhost:3000

# Compte de démonstration
AUTH_DEMO_EMAIL=demo@shoppay.cm
AUTH_DEMO_PASSWORD=Demo1234!

# URL publique du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de données PostgreSQL (optionnelle : sans elle, les données initiales sont utilisées)
# Exemple local (Laragon/Postgres) : postgresql://shoppay:shoppay@localhost:5432/shoppay
DATABASE_URL=
DATABASE_SSL=prefer

# Monetbil
# Clés disponibles sur https://www.monetbil.com/services
MONETBIL_SERVICE_KEY=
MONETBIL_SERVICE_SECRET=
# Paiement réel uniquement. Les clés doivent être renseignées.
MONETBIL_DEMO=false
MONETBIL_LOGO_URL=
